# Copy to /etc/youtube-transcripts.env (mode 0600, owned by root).

# Address and port that uvicorn listens on.
YT_TRANSCRIPTS_HOST=127.0.0.1
YT_TRANSCRIPTS_PORT=8765

# Runtime data: audio/, transcripts/ and jobs.db.
YT_TRANSCRIPTS_DATA_DIR=/var/lib/youtube-transcripts

# faster-whisper model: tiny, base, small, medium, large-v3, ...
YT_TRANSCRIPTS_WHISPER_MODEL=medium

# Optional: the built frontend. Default: frontend/dist in the checkout.
# YT_TRANSCRIPTS_FRONTEND_DIST=/srv/youtube-transcripts/frontend/dist

# The `claude` CLI must be on PATH.
PATH=/usr/local/bin:/usr/bin:/bin

# Claude authentication: either a subscription token from `claude setup-token`
# or an API key (billed per call). Set one.
CLAUDE_CODE_OAUTH_TOKEN=<from-claude-setup-token>
# ANTHROPIC_API_KEY=<api-key>

# Keep the service's Claude settings apart from any user's ~/.claude.
CLAUDE_CONFIG_DIR=/var/lib/youtube-transcripts/claude
